# ---------------------------------------------------------------------
# dragonballquiz.com — configuration Apache (hebergement mutualise OVH)
# Ce fichier est copie tel quel dans dist/ au build.
# ---------------------------------------------------------------------

AddDefaultCharset UTF-8

# --- Compression -----------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache -----------------------------------------------------------
<IfModule mod_headers.c>
  # Les fichiers de dist/assets/ portent un hash dans leur nom : leur
  # contenu ne change jamais sans que le nom change aussi.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html doit toujours etre reverifie, sinon un ancien HTML
  # continuerait de pointer vers des assets supprimes.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(svg|ico|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Types MIME ------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Pas de regle de reecriture SPA : le site tient dans une seule page,
# la navigation se fait entierement cote client sans changer d'URL.
